<?php
session_start();
if (!isset($_SESSION['user_id']) || $_SESSION['role'] !== 'admin') {
    header('Location: ../../index.php');
    exit();
}

require_once '../../config/database.php';

$db = new Database();
$message = '';
$message_type = '';

// Create rooms table if it doesn't exist
try {
    $db->query("CREATE TABLE IF NOT EXISTS `rooms` (
        `id` int(11) NOT NULL AUTO_INCREMENT,
        `room_name` varchar(100) NOT NULL,
        `capacity` int(11) NOT NULL,
        `status` enum('available','unavailable') NOT NULL DEFAULT 'available',
        `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
        `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
        PRIMARY KEY (`id`),
        UNIQUE KEY `room_name` (`room_name`)
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci");
    $db->execute();
    
    // Check if we need to insert sample data
    $db->query("SELECT COUNT(*) as count FROM `rooms`");
    $count = $db->single();
    
    if ($count && $count['count'] == 0) {
        $sampleRooms = [
            ['Room 101', 30, 'available'],
            ['Room 102', 25, 'available'],
            ['Lab A', 20, 'available'],
            ['Conference Room', 15, 'unavailable'],
            ['Computer Lab', 25, 'available']
        ];
        
        foreach ($sampleRooms as $room) {
            $db->query("INSERT INTO `rooms` (`room_name`, `capacity`, `status`) VALUES (?, ?, ?)");
            $db->bind(1, $room[0]);
            $db->bind(2, $room[1], PDO::PARAM_INT);
            $db->bind(3, $room[2]);
            $db->execute();
        }
    }
    
} catch (Exception $e) {
    $message = 'Error initializing database: ' . $e->getMessage();
    $message_type = 'error';
}

// Fetch all rooms
$rooms = [];
try {
    // Verify database connection
    if (!($db instanceof Database)) {
        throw new Exception('Database connection failed');
    }
    
    // Create rooms table if it doesn't exist (in case it was missed earlier)
    $db->query("CREATE TABLE IF NOT EXISTS `rooms` (
        `id` int(11) NOT NULL AUTO_INCREMENT,
        `room_name` varchar(100) NOT NULL,
        `capacity` int(11) NOT NULL,
        `status` enum('available','unavailable') NOT NULL DEFAULT 'available',
        `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
        `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
        PRIMARY KEY (`id`),
        UNIQUE KEY `room_name` (`room_name`)
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci");
    $db->execute();
    
    // Check if we need to insert sample data
    $db->query("SELECT COUNT(*) as count FROM `rooms`");
    $count = $db->single();
    
    if ($count && $count['count'] == 0) {
        $sampleRooms = [
            ['Room 101', 30, 'available'],
            ['Room 102', 25, 'available'],
            ['Lab A', 20, 'available'],
            ['Conference Room', 15, 'unavailable'],
            ['Computer Lab', 25, 'available']
        ];
        
        foreach ($sampleRooms as $room) {
            $db->query("INSERT INTO `rooms` (`room_name`, `capacity`, `status`) VALUES (?, ?, ?)");
            $db->bind(1, $room[0]);
            $db->bind(2, $room[1], PDO::PARAM_INT);
            $db->bind(3, $room[2]);
            $db->execute();
        }
    }
    
    // Fetch all rooms
    $db->query("SELECT * FROM `rooms` ORDER BY room_name ASC");
    $result = $db->resultset();
    $rooms = is_array($result) ? $result : [];
    
} catch (Exception $e) {
    $message = 'Error initializing rooms data: ' . $e->getMessage();
    $message_type = 'error';
    error_log('Rooms Dashboard Error: ' . $e->getMessage());
}

// Handle form submissions
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (isset($_POST['action'])) {
        switch ($_POST['action']) {
            case 'add_room':
                $room_name = trim($_POST['room_name']);
                $capacity = intval($_POST['capacity']);
                $status = $_POST['status'] === 'available' ? 'available' : 'unavailable';
                
                try {
                    $db->query("INSERT INTO rooms (room_name, capacity, status) VALUES (?, ?, ?)");
                    $db->bind(1, $room_name);
                    $db->bind(2, $capacity, PDO::PARAM_INT);
                    $db->bind(3, $status);
                    $db->execute();
                    $message = 'Room added successfully';
                    $message_type = 'success';
                } catch (Exception $e) {
                    $message = 'Error adding room: ' . $e->getMessage();
                    $message_type = 'error';
                }
                break;
                
            case 'update_room':
                $room_id = intval($_POST['room_id']);
                $room_name = trim($_POST['room_name']);
                $capacity = intval($_POST['capacity']);
                $status = $_POST['status'] === 'available' ? 'available' : 'unavailable';
                
                try {
                    $db->query("UPDATE rooms SET room_name = ?, capacity = ?, status = ? WHERE id = ?");
                    $db->bind(1, $room_name);
                    $db->bind(2, $capacity, PDO::PARAM_INT);
                    $db->bind(3, $status);
                    $db->bind(4, $room_id, PDO::PARAM_INT);
                    $db->execute();
                    $message = 'Room updated successfully';
                    $message_type = 'success';
                } catch (Exception $e) {
                    $message = 'Error updating room: ' . $e->getMessage();
                    $message_type = 'error';
                }
                break;
                
            case 'delete_room':
                $room_id = intval($_POST['room_id']);
                try {
                    $db->query("DELETE FROM rooms WHERE id = ?");
                    $db->bind(1, $room_id, PDO::PARAM_INT);
                    $db->execute();
                    $message = 'Room deleted successfully';
                    $message_type = 'success';
                } catch (Exception $e) {
                    $message = 'Error deleting room: ' . $e->getMessage();
                    $message_type = 'error';
                }
                break;
        }
    }
}

// Fetch all rooms
$rooms = [];
try {
    $db->query("SELECT * FROM rooms ORDER BY room_name");
    $rooms = $db->resultset();
} catch (Exception $e) {
    $message = 'Error fetching rooms: ' . $e->getMessage();
    $message_type = 'error';
}
?>
